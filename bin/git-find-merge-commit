#! /bin/bash
# Usage:
# git find-merge-commit <commit> [branch]
# - commit has changes of interest
# - branch is the ref that already contains the changes. Defaults to current branch.
#
# Return the merge commit where the changes were first introduced
set -euo pipefail

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    echo 'usage: git find-merge-commit <commit> [branch]'
    exit 0
fi

if [[ $# -lt 1 ]]; then
    echo 'usage: git find-merge-commit <commit> [branch]' >&2
    exit 1
fi

COMMIT=$1
BRANCH=${2:-HEAD}

git rev-list --ancestry-path "$COMMIT".."$BRANCH" | grep -Fxf <(git rev-list --first-parent "$COMMIT".."$BRANCH") | tail -1
